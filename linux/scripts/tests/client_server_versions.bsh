#!/usr/bin/env bash

# Run with: bash linux/scripts/tests/client_server_versions.bsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT
mkdir -p "$fixture/desktop/linux/scripts" "$fixture/desktop/local_server" \
  "$fixture/client-a" "$fixture/client-b" "$fixture/client-c"
cp "$SCRIPT_DIR/../client_server_versions.bsh" "$fixture/desktop/linux/scripts/"
printf 'CLIENT1=client-a\nCLIENT2=client-b\nCLIENT3=client-c\n' > "$fixture/desktop/app_config.env"
printf 'pankosmia_web = "=0.15.0"\n' > "$fixture/desktop/local_server/Cargo.toml"
printf 'dev=0.14.0\nqa=0.13.0\n' > "$fixture/desktop/local_server.env"
printf '{}\n' > "$fixture/client-c/pankosmia_metadata.json"

check_range() {
  local label="$1" expected_min="$2" expected_max="$3" expected_status="$4"
  local output status=0
  output=$(bash "$fixture/desktop/linux/scripts/client_server_versions.bsh" 2>&1) || status=$?
  if [ "$status" -ne "$expected_status" ] ||
     ! grep -Fq "Minimum server version: $expected_min" <<< "$output" ||
     ! grep -Fq "Maximum server version: $expected_max" <<< "$output"; then
    printf 'FAIL: %s (exit %s)\n%s\n' "$label" "$status" "$output" >&2
    exit 1
  fi
  if [ "$expected_status" -eq 1 ] &&
     ! grep -Fq 'ERROR: No server version is compatible with all clients.' <<< "$output"; then
    printf 'FAIL: %s did not report an empty intersection\n%s\n' "$label" "$output" >&2
    exit 1
  fi
  printf 'PASS: %s\n' "$label"
}

printf '{"minServerVersion":"0.9.0","maxServerVersion":"0.30.0"}\n' > "$fixture/client-a/pankosmia_metadata.json"
printf '{"minServerVersion":"0.10.0","maxServerVersion":"0.20.0"}\n' > "$fixture/client-b/pankosmia_metadata.json"
check_range 'highest minimum, lowest maximum' '0.10.0 (set by client-b)' '0.20.0 (set by client-b)' 0

mv "$fixture/client-a/pankosmia_metadata.json" "$fixture/swap.json"
mv "$fixture/client-b/pankosmia_metadata.json" "$fixture/client-a/pankosmia_metadata.json"
mv "$fixture/swap.json" "$fixture/client-b/pankosmia_metadata.json"
check_range 'independent of client order' '0.10.0 (set by client-a)' '0.20.0 (set by client-a)' 0

printf '{"minServerVersion":"0.15.0","maxServerVersion":"0.20.0"}\n' > "$fixture/client-a/pankosmia_metadata.json"
printf '{"minServerVersion":"0.10.0","maxServerVersion":"0.15.0"}\n' > "$fixture/client-b/pankosmia_metadata.json"
check_range 'inclusive shared boundary' '0.15.0 (set by client-a)' '0.15.0 (set by client-b)' 0

printf '{"minServerVersion":"0.21.0"}\n' > "$fixture/client-a/pankosmia_metadata.json"
check_range 'disjoint ranges' '0.21.0 (set by client-a)' '0.15.0 (set by client-b)' 1

printf '{}\n' > "$fixture/client-a/pankosmia_metadata.json"
printf '{}\n' > "$fixture/client-b/pankosmia_metadata.json"
check_range 'missing bounds are unconstrained' 'none' 'none' 0

mkdir -p "$fixture/bin" "$fixture/remote"
export VERSION_TEST_REMOTE="$fixture/remote"
cat > "$fixture/bin/git" <<'EOF'
#!/usr/bin/env bash
set -eu
[ "$1" = ls-remote ] && [ "$2" = --exit-code ] && [ "$3" = --heads ] || exit 99
repo=${4#https://github.com/pankosmia/}
repo=${repo%.git}
branch=${5#refs/heads/}
if [ -f "$VERSION_TEST_REMOTE/$repo/lookup-error" ]; then
  exit 128
fi
[ -d "$VERSION_TEST_REMOTE/$repo/$branch" ] && exit 0
exit 2
EOF
cat > "$fixture/bin/curl" <<'EOF'
#!/usr/bin/env bash
set -eu
[ "$1" = -sSL ] && [ "$2" = -o ] && [ "$4" = -w ] || exit 99
path=${6#https://raw.githubusercontent.com/pankosmia/}
if [ -f "$VERSION_TEST_REMOTE/$path" ]; then
  cp "$VERSION_TEST_REMOTE/$path" "$3"
  printf 200
else
  printf 404
fi
EOF
chmod +x "$fixture/bin/git" "$fixture/bin/curl"
export PATH="$fixture/bin:$PATH"

for client in client-a client-b client-c; do
  mkdir -p "$fixture/remote/$client/main"
  printf '{"minServerVersion":"0.10.0"}\n' > "$fixture/remote/$client/main/pankosmia_metadata.json"
done
mkdir -p "$fixture/remote/client-a/dev" "$fixture/remote/client-a/qa" "$fixture/remote/client-b/qa"
printf '{"minServerVersion":"0.14.0"}\n' > "$fixture/remote/client-a/dev/pankosmia_metadata.json"
printf '{"minServerVersion":"0.13.0"}\n' > "$fixture/remote/client-a/qa/pankosmia_metadata.json"
printf '{"minServerVersion":"0.12.0"}\n' > "$fixture/remote/client-b/qa/pankosmia_metadata.json"

check_branches() {
  local label="$1" branch="$2" expected_min="$3" expected_status="$4"
  local output status=0 expected
  shift 4
  output=$(bash "$fixture/desktop/linux/scripts/client_server_versions.bsh" "$branch" 2>&1) || status=$?
  if [ "$status" -ne "$expected_status" ] ||
     { [ -n "$expected_min" ] && ! grep -Fq "Minimum server version: $expected_min" <<< "$output"; }; then
    printf 'FAIL: %s (exit %s)\n%s\n' "$label" "$status" "$output" >&2
    exit 1
  fi
  for expected in "$@"; do
    if ! grep -Eq "$expected" <<< "$output"; then
      printf 'FAIL: %s (missing %s)\n%s\n' "$label" "$expected" "$output" >&2
      exit 1
    fi
  done
  printf 'PASS: %s\n' "$label"
}

check_branches 'dev uses dev, qa, main per client despite local metadata' dev '0.14.0' 0 \
  'client-a +0.14.0 +- +github:dev$' \
  'client-b +0.12.0 +- +github:qa$' \
  'client-c +0.10.0 +- +github:main$' \
  'Configured server version \(local_server.env \(dev\)\): 0.14.0$'
check_branches 'qa uses qa then main' qa '0.13.0' 0 \
  'client-a +0.13.0 +- +github:qa$' \
  'client-c +0.10.0 +- +github:main$' \
  'Configured server version \(local_server.env \(qa\)\): 0.13.0$'
check_branches 'explicit main ignores local metadata' main '0.10.0' 0 \
  'Configured server version \(local_server/Cargo.toml\): 0.15.0$'
check_branches 'remote-only defaults to main' -r '0.10.0' 0 \
  'Configured server version \(local_server/Cargo.toml\): 0.15.0$'

printf 'dev=0.11.0\nqa=0.12.0\n' > "$fixture/desktop/local_server.env"
check_branches 'dev checks env version rather than compatible Cargo version' dev '0.14.0' 1 \
  'Configured server version \(local_server.env \(dev\)\): 0.11.0$' \
  'ERROR: Configured server version is outside the compatible range.'
check_branches 'qa checks its own env version' qa '0.13.0' 1 \
  'Configured server version \(local_server.env \(qa\)\): 0.12.0$' \
  'ERROR: Configured server version is outside the compatible range.'

printf 'dev=\nqa=0.13.0\n' > "$fixture/desktop/local_server.env"
check_branches 'empty dev version is an error' dev '0.14.0' 2 \
  'ERROR: Could not find a server version in local_server.env \(dev\).'
printf 'dev=0.14.0\n' > "$fixture/desktop/local_server.env"
check_branches 'missing qa value does not use dev or Cargo version' qa '0.13.0' 2 \
  'ERROR: Could not find a server version in local_server.env \(qa\).'
rm "$fixture/desktop/local_server.env"
check_branches 'missing server env file is an error' dev '0.14.0' 2 \
  'ERROR: Could not read local_server.env.'
check_branches 'main does not require server env file' main '0.10.0' 0 \
  'Configured server version \(local_server/Cargo.toml\): 0.15.0$'
printf 'dev=0.14.0\nqa=0.13.0\n' > "$fixture/desktop/local_server.env"

mkdir -p "$fixture/saved-branches"
mv "$fixture/remote/client-a/dev" "$fixture/saved-branches/dev"
mv "$fixture/remote/client-a/qa" "$fixture/saved-branches/qa"
mv "$fixture/remote/client-b/qa" "$fixture/saved-branches/client-b-qa"
check_branches 'all clients falling back to main still use requested dev server' dev '0.10.0' 0 \
  'client-a +0.10.0 +- +github:main$' \
  'client-b +0.10.0 +- +github:main$' \
  'Configured server version \(local_server.env \(dev\)\): 0.14.0$'
mv "$fixture/saved-branches/dev" "$fixture/remote/client-a/dev"
mv "$fixture/saved-branches/qa" "$fixture/remote/client-a/qa"
mv "$fixture/saved-branches/client-b-qa" "$fixture/remote/client-b/qa"

rm "$fixture/remote/client-a/dev/pankosmia_metadata.json"
check_branches 'existing dev without metadata does not fall back to qa' dev '0.12.0' 0 \
  'client-a +- +- +github:dev \(no pankosmia_metadata.json\)'

touch "$fixture/remote/client-a/lookup-error"
check_branches 'branch lookup errors are fatal, not fallback' dev '' 2 \
  'ERROR: Could not check branch dev for client-a.' \
  'client-a +\? +\? +branch lookup failed'
rm "$fixture/remote/client-a/lookup-error"
check_branches 'missing requested branch is an error' unknown '' 2 \
  'ERROR: No requested or fallback branch found for client-a.'
