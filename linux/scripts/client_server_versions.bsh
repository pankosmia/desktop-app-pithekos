#!/usr/bin/env bash

# Run from: pankosmia/<repo-name>/linux/scripts

# Calculates the range of pankosmia_web server versions compatible with every client
# listed in app_config.env, using minServerVersion and maxServerVersion from each
# client's pankosmia_metadata.json.

# Usage:
#   ./client_server_versions.bsh [-r] [branch]
#     -r      Always read pankosmia_metadata.json from GitHub, ignoring local clones
#     branch  Client branch to read from GitHub (default: main)
#             dev falls back to qa, then main; qa falls back to main.
#             Fallback happens only when a branch does not exist.
#   An explicit branch argument ignores local clones.
#   By default, local clones next to this repo (as created by clone.bsh) are used,
#   falling back to GitHub when a client has not been cloned.
#   The configured server version comes from local_server.env for dev/qa,
#   otherwise from local_server/Cargo.toml, regardless of client fallbacks.

# Exit codes:
#   0  A compatible range exists and includes the configured server version
#   1  No compatible range, or the configured server version is outside the range
#   2  Usage, fetch, or server configuration error

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
PARENT_DIR="$(cd "$REPO_DIR/.." && pwd)"

REMOTE_ONLY=""
BRANCH="main"
BRANCH_SPECIFIED=""
for arg in "$@"; do
  case "$arg" in
    -r) REMOTE_ONLY="yes" ;;
    -h|--help)
      sed -n '3,/^SCRIPT_DIR/{ /^#/s/^# \{0,1\}//p; }' "$0"
      exit 0
      ;;
    -*) echo "Unknown option: $arg" >&2; exit 2 ;;
    *)
      if [ -n "$BRANCH_SPECIFIED" ] || [ -z "$arg" ]; then
        echo "Expected at most one nonempty branch argument." >&2
        exit 2
      fi
      BRANCH="$arg"
      BRANCH_SPECIFIED="yes"
      ;;
  esac
done

source "$REPO_DIR/app_config.env"

# Prints the value of a top-level string key from JSON on stdin
json_string_value() {
  grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -n 1 | sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/'
}

# Removes a leading "=", "v" or spaces, e.g. "=0.20.3" -> "0.20.3"
clean_version() {
  sed 's/^[[:space:]=v]*//; s/[[:space:]]*$//' <<< "$1"
}

# Succeeds if version $1 <= version $2
version_le() {
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]
}

version_lt() {
  [ "$1" != "$2" ] && version_le "$1" "$2"
}

# Prints where a client's pankosmia_metadata.json will be read from
metadata_source() {
  if [ -z "$REMOTE_ONLY" ] && [ -z "$BRANCH_SPECIFIED" ] &&
     [ -f "$PARENT_DIR/$1/pankosmia_metadata.json" ]; then
    echo "local"
    return
  fi

  local candidate status
  local branches=("$BRANCH")
  case "$BRANCH" in
    dev) branches+=(qa main) ;;
    qa) branches+=(main) ;;
  esac
  for candidate in "${branches[@]}"; do
    git ls-remote --exit-code --heads "https://github.com/pankosmia/$1.git" \
      "refs/heads/$candidate" > /dev/null
    status=$?
    case "$status" in
      0) echo "github:$candidate"; return ;;
      2) continue ;;
      *)
        echo "ERROR: Could not check branch $candidate for $1." >&2
        return 1
        ;;
    esac
  done
  echo "ERROR: No requested or fallback branch found for $1." >&2
  return 1
}

# Prints the content of a client's pankosmia_metadata.json from source $2
# Returns 3 if the file does not exist, 1 on any other error
get_metadata() {
  if [ "$2" = "local" ]; then
    cat "$PARENT_DIR/$1/pankosmia_metadata.json"
    return
  fi
  local tmp status
  tmp=$(mktemp)
  status=$(curl -sSL -o "$tmp" -w '%{http_code}' "https://raw.githubusercontent.com/pankosmia/$1/${2#github:}/pankosmia_metadata.json")
  case "$status" in
    200) cat "$tmp"; rm -f "$tmp" ;;
    404) rm -f "$tmp"; return 3 ;;
    *) rm -f "$tmp"; return 1 ;;
  esac
}

overallMin=""
overallMinClient=""
overallMax=""
overallMaxClient=""
errors=0

printf '%-42s %-12s %-12s %s\n' "CLIENT" "MIN" "MAX" "SOURCE"
for ((i=1;;i++)); do
  eval client='$'CLIENT$i
  [ -z "$client" ] && break
  client=$(sed 's/ //g' <<< "$client")

  if ! SOURCE=$(metadata_source "$client"); then
    printf '%-42s %-12s %-12s %s\n' "$client" "?" "?" "branch lookup failed"
    errors=$((errors+1))
    continue
  fi
  metadata=$(get_metadata "$client" "$SOURCE")
  result=$?
  if [ "$result" -eq 3 ]; then
    printf '%-42s %-12s %-12s %s\n' "$client" "-" "-" "$SOURCE (no pankosmia_metadata.json)"
    continue
  elif [ "$result" -ne 0 ]; then
    printf '%-42s %-12s %-12s %s\n' "$client" "?" "?" "$SOURCE (fetch failed)"
    errors=$((errors+1))
    continue
  fi

  min=$(clean_version "$(json_string_value minServerVersion <<< "$metadata")")
  max=$(clean_version "$(json_string_value maxServerVersion <<< "$metadata")")
  printf '%-42s %-12s %-12s %s\n' "$client" "${min:--}" "${max:--}" "$SOURCE"

  # The overall minimum is the highest minimum; the overall maximum is the lowest maximum
  if [ -n "$min" ] && { [ -z "$overallMin" ] || version_lt "$overallMin" "$min"; }; then
    overallMin="$min"
    overallMinClient="$client"
  fi
  if [ -n "$max" ] && { [ -z "$overallMax" ] || version_lt "$max" "$overallMax"; }; then
    overallMax="$max"
    overallMaxClient="$client"
  fi
done

echo
if [ "$errors" -gt 0 ]; then
  echo "ERROR: Could not read pankosmia_metadata.json for $errors client(s)." >&2
  exit 2
fi

echo "Minimum server version: ${overallMin:-none}${overallMinClient:+ (set by $overallMinClient)}"
echo "Maximum server version: ${overallMax:-none}${overallMaxClient:+ (set by $overallMaxClient)}"

if [ -n "$overallMin" ] && [ -n "$overallMax" ] && ! version_le "$overallMin" "$overallMax"; then
  echo "ERROR: No server version is compatible with all clients." >&2
  exit 1
fi

case "$BRANCH" in
  dev|qa)
    serverSource="local_server.env ($BRANCH)"
    if [ ! -r "$REPO_DIR/local_server.env" ]; then
      echo "ERROR: Could not read local_server.env." >&2
      exit 2
    fi
    serverVersion=$(grep "^${BRANCH}=" "$REPO_DIR/local_server.env" | cut -d'=' -f2-)
    ;;
  *)
    serverSource="local_server/Cargo.toml"
    if [ ! -r "$REPO_DIR/local_server/Cargo.toml" ]; then
      echo "ERROR: Could not read local_server/Cargo.toml." >&2
      exit 2
    fi
    serverVersion=$(grep -o '^pankosmia_web[[:space:]]*=[[:space:]]*"[^"]*"' "$REPO_DIR/local_server/Cargo.toml" | sed 's/.*"\(.*\)"/\1/')
    ;;
esac
serverVersion=$(clean_version "$serverVersion")
if [ -z "$serverVersion" ]; then
  echo "ERROR: Could not find a server version in $serverSource." >&2
  exit 2
fi
echo "Configured server version ($serverSource): $serverVersion"
if { [ -n "$overallMin" ] && ! version_le "$overallMin" "$serverVersion"; } || \
   { [ -n "$overallMax" ] && ! version_le "$serverVersion" "$overallMax"; }; then
  echo "ERROR: Configured server version is outside the compatible range." >&2
  exit 1
fi
echo "Configured server version is compatible with all clients."
